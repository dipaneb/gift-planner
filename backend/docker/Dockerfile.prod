FROM python:3.14-slim-bookworm

WORKDIR /app

# Copy requirements
COPY requirements-prod.txt .

# Install dependencies
RUN pip install --no-cache-dir --upgrade -r requirements-prod.txt

# Copy source code
COPY . .

# Expose port
EXPOSE 8000

# Apply pending database migrations, then run the app.
# If a migration fails, the app doesn't start instead of running on an outdated schema.
# exec: fastapi replaces the shell, so it receives the stop signals directly.
CMD ["sh", "-c", "alembic upgrade head && exec fastapi run src/main.py"]
